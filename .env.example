# .env.example — Configuração de Deploy NAS & Portas Docker
# Copie para .env e ajuste com os dados do seu NAS:
# cp .env.example .env

# Ligação SSH ao NAS
NAS_HOST=192.168.68.250
NAS_USER=admin
NAS_SSH_PORT=22
NAS_DEPLOY_PATH=/volume1/docker/slidofnac

# Portas no NAS (Produção e Staging)
PROD_PORT=4321
STAGING_PORT=4322

# URL Público opcional (ex: Reverse Proxy do NAS ou Túnel Cloudflare)
# Se vazio, usa automaticamente o IP/Host do NAS acedido no browser
PROD_PUBLIC_URL=
STAGING_PUBLIC_URL=
