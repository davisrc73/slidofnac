    <script>
        // Modal de Manuais & Runbook
        const manualsModal = document.getElementById('manuals-modal');
        document.getElementById('btn-open-manuals')?.addEventListener('click', () => {
            manualsModal?.classList.remove('hidden');
            manualsModal?.classList.add('flex');
        });
        document.getElementById('btn-close-manuals')?.addEventListener('click', () => {
            manualsModal?.classList.add('hidden');
            manualsModal?.classList.remove('flex');
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && manualsModal && !manualsModal.classList.contains('hidden')) {
                manualsModal.classList.add('hidden');
                manualsModal.classList.remove('flex');
            }
        });
        document.querySelectorAll('.doc-tab-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                const targetTab = (btn as HTMLElement).dataset.docTab;
                document.querySelectorAll('.doc-tab-btn').forEach((b) => {
                    const isActive = (b as HTMLElement).dataset.docTab === targetTab;
                    b.className = isActive
                        ? 'doc-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-[#141414] text-[#FFCC00] cursor-pointer'
                        : 'doc-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-bold bg-white text-gray-700 border border-gray-200 cursor-pointer';
                });
                document.querySelectorAll('.doc-panel').forEach((p) => {
                    p.classList.toggle('hidden', p.id !== `doc-panel-${targetTab}`);
                });
            });
        });

        const MODEL_META: Record<string, { badge: string; color: string }> = {
            quiz: { badge: '🏆 Quiz', color: 'bg-[#D93805] text-white' },
            boolean: { badge: '🏆 V/F', color: 'bg-[#D93805] text-white' },
            poll: { badge: '📊 Multiple choice', color: 'bg-[#2563EB] text-white' },
            wordcloud: { badge: '☁️ Word cloud', color: 'bg-[#7C3AED] text-white' },
            opentext: { badge: '💬 Open text', color: 'bg-[#0D9488] text-white' },
            ideas: { badge: '💡 Ideas', color: 'bg-[#65A30D] text-white' },
            ranking: { badge: '🏅 Ranking', color: 'bg-[#DB2777] text-white' },
            rating: { badge: '⭐ Rating', color: 'bg-[#CA8A04] text-white' },
            survey: { badge: '📋 Survey', color: 'bg-gray-800 text-white' },
        };

        // Alternar Abas
        const tabBtnLive = document.getElementById('tab-btn-live');
        const tabBtnSlido = document.getElementById('tab-btn-slido');
        const tabPanelLive = document.getElementById('tab-panel-live');
        const tabPanelSlido = document.getElementById('tab-panel-slido');

        tabBtnLive?.addEventListener('click', () => {
            tabPanelLive?.classList.remove('hidden');
            tabPanelLive?.classList.add('grid');
            tabPanelSlido?.classList.add('hidden');
            tabPanelSlido?.classList.remove('grid');
            tabBtnLive.className = 'px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-[#FFCC00] text-black transition cursor-pointer';
            if (tabBtnSlido) tabBtnSlido.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold text-gray-300 hover:text-white transition cursor-pointer';
        });

        tabBtnSlido?.addEventListener('click', () => {
            tabPanelSlido?.classList.remove('hidden');
            tabPanelSlido?.classList.add('grid');
            tabPanelLive?.classList.add('hidden');
            tabPanelLive?.classList.remove('grid');
            tabBtnSlido.className = 'px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-[#FFCC00] text-black transition cursor-pointer';
            if (tabBtnLive) tabBtnLive.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold text-gray-300 hover:text-white transition cursor-pointer';
        });

        let latestLiveState: any = null;
        let allStandings: any[] = [];
        let activeTopLimit = 5;
        let uploadMode: 'merge' | 'replace' = 'merge';
        const selectedKeys = new Map<string, string>();

        async function sendHostCmd(payload: any) {
            const res = await fetch('/api/live/control', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            if (res.ok) {
                const data = await res.json();
                renderAll(data);
            }
        }

        // Botões do Telecomando
        document.getElementById('btn-cmd-lobby')?.addEventListener('click', () =>
            sendHostCmd({ action: 'set_status', status: 'lobby' })
        );
        document.getElementById('btn-cmd-open-q')?.addEventListener('click', () =>
            sendHostCmd({
                action: 'open_question',
                questionIndex: latestLiveState?.currentQuestionIndex || 0,
            })
        );
        document.getElementById('btn-cmd-reveal')?.addEventListener('click', () =>
            sendHostCmd({ action: 'reveal_answer' })
        );
        document.getElementById('btn-cmd-next-q')?.addEventListener('click', () =>
            sendHostCmd({ action: 'next_question' })
        );
        document.getElementById('btn-cmd-leaderboard')?.addEventListener('click', () =>
            sendHostCmd({ action: 'set_status', status: 'leaderboard', leaderboardMode: 'individual' })
        );
        document.getElementById('btn-cmd-teams-leaderboard')?.addEventListener('click', () =>
            sendHostCmd({ action: 'set_status', status: 'leaderboard', leaderboardMode: 'teams' })
        );
        document.getElementById('btn-cmd-reset-answers')?.addEventListener('click', () => {
            if (confirm('Tem a certeza que pretende limpar as respostas desta sessão para começar do zero?')) {
                sendHostCmd({ action: 'reset_quiz_answers' });
            }
        });

        // Criar Nova Sessão
        document.getElementById('form-new-quiz')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const codeEl = document.getElementById('new-quiz-code') as HTMLInputElement;
            const titleEl = document.getElementById('new-quiz-title') as HTMLInputElement;
            await sendHostCmd({
                action: 'create_quiz',
                code: codeEl.value,
                title: titleEl.value,
            });
            codeEl.value = '';
            titleEl.value = '';
        });

        // Rede & Roster
        document.getElementById('btn-save-url')?.addEventListener('click', () => {
            const val = (document.getElementById('input-public-url') as HTMLInputElement)?.value || '';
            sendHostCmd({ action: 'set_network_config', publicBaseUrl: val });
        });
        document.getElementById('chk-include-imported')?.addEventListener('change', (e) => {
            const checked = (e.currentTarget as HTMLInputElement).checked;
            sendHostCmd({ action: 'set_network_config', includeImportedRounds: checked });
        });
        document.getElementById('btn-add-roster')?.addEventListener('click', async () => {
            const ta = document.getElementById('textarea-roster') as HTMLTextAreaElement;
            if (!ta || !ta.value.trim()) return;
            await sendHostCmd({ action: 'add_roster', rawText: ta.value });
            ta.value = '';
        });

        // === Editor dos 8 Modelos de Interação ===
        const formQuestion = document.getElementById('form-question') as HTMLFormElement | null;
        const editQId = document.getElementById('edit-q-id') as HTMLInputElement | null;
        const editQType = document.getElementById('edit-q-type') as HTMLInputElement | null;
        const editQText = document.getElementById('edit-q-text') as HTMLInputElement | null;
        const editQTime = document.getElementById('edit-q-time') as HTMLInputElement | null;
        const editQMultiplier = document.getElementById('edit-q-multiplier') as HTMLSelectElement | null;
        const editQImageUrl = document.getElementById('edit-q-image-url') as HTMLInputElement | null;
        const editQImageReveal = document.getElementById('edit-q-image-reveal') as HTMLSelectElement | null;
        const editQMaxStars = document.getElementById('edit-q-max-stars') as HTMLSelectElement | null;
        const editQOptionsBox = document.getElementById('edit-q-options-box');
        const surveySubsBox = document.getElementById('survey-subs-box');

        function selectInteractionModel(modelType: string) {
            if (!editQType) return;
            const normalizedType = modelType === 'boolean' ? 'quiz' : modelType;
            editQType.value = normalizedType;

            document.querySelectorAll('.model-card-btn').forEach((btn) => {
                const m = (btn as HTMLElement).dataset.model;
                if (m === normalizedType) {
                    btn.className =
                        'model-card-btn group text-left p-2.5 rounded-xl border-2 border-[#141414] bg-amber-50/80 shadow-sm transition cursor-pointer flex flex-col justify-between';
                } else {
                    btn.className =
                        'model-card-btn group text-left p-2.5 rounded-xl border border-gray-200 bg-white hover:border-gray-400 transition cursor-pointer flex flex-col justify-between';
                }
            });

            const quizExtra = document.getElementById('quiz-extra-settings');
            const optionsSec = document.getElementById('options-editor-section');
            const optionsLabel = document.getElementById('options-editor-label');
            const ratingSec = document.getElementById('rating-editor-section');
            const surveySec = document.getElementById('survey-editor-section');

            const needsOptions = normalizedType === 'quiz' || normalizedType === 'poll' || normalizedType === 'ranking';
            if (optionsSec) optionsSec.classList.toggle('hidden', !needsOptions);
            if (quizExtra) quizExtra.classList.toggle('hidden', normalizedType !== 'quiz');
            if (ratingSec) ratingSec.classList.toggle('hidden', normalizedType !== 'rating');
            if (surveySec) {
                surveySec.classList.toggle('hidden', normalizedType !== 'survey');
                surveySec.classList.toggle('flex', normalizedType === 'survey');
            }

            if (optionsLabel) {
                optionsLabel.textContent =
                    normalizedType === 'quiz'
                        ? 'Opções de Resposta (marque o círculo verde na resposta correta)'
                        : normalizedType === 'ranking'
                        ? 'Itens para os participantes ordenarem por preferência'
                        : 'Opções de Votação (Multiple choice)';
            }

            // Esconder ou mostrar radio buttons de resposta certa consoante seja Quiz ou Poll/Ranking
            document.querySelectorAll('.q-opt-radio').forEach((r) => {
                (r as HTMLElement).classList.toggle('hidden', normalizedType !== 'quiz');
            });
        }

        document.querySelectorAll('.model-card-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                const model = (btn as HTMLElement).dataset.model || 'quiz';
                selectInteractionModel(model);
            });
        });

        function buildOptionInputs(options: string[], correctIdx: number, modelType = 'quiz') {
            if (!editQOptionsBox) return;
            const showRadio = modelType === 'quiz' || modelType === 'boolean';
            editQOptionsBox.innerHTML = options
                .map(
                    (opt, idx) => `
                    <div class="flex items-center gap-2 q-opt-row">
                        <input
                            type="radio"
                            name="correctOption"
                            value="${idx}"
                            ${idx === correctIdx ? 'checked' : ''}
                            class="q-opt-radio ${showRadio ? '' : 'hidden'} w-4 h-4 accent-emerald-600 cursor-pointer"
                            title="Marcar como resposta certa"
                        />
                        <input
                            type="text"
                            value="${String(opt || '').replace(/"/g, '&quot;')}"
                            placeholder="Opção ${idx + 1}"
                            class="q-opt-input flex-1 px-3 py-2 rounded-lg border border-gray-300 text-xs font-semibold bg-white"
                        />
                        <button type="button" class="btn-del-opt text-gray-400 hover:text-red-600 px-1.5 text-xs font-bold cursor-pointer" title="Remover opção">✕</button>
                    </div>
                `
                )
                .join('');

            editQOptionsBox.querySelectorAll('.btn-del-opt').forEach((b) => {
                b.addEventListener('click', () => {
                    if (editQOptionsBox.querySelectorAll('.q-opt-row').length > 2) {
                        b.closest('.q-opt-row')?.remove();
                    }
                });
            });
        }

        document.getElementById('btn-add-opt-row')?.addEventListener('click', () => {
            const currentOpts: string[] = [];
            document.querySelectorAll('.q-opt-input').forEach((inp) => {
                currentOpts.push((inp as HTMLInputElement).value);
            });
            currentOpts.push('');
            const checkedRadio = document.querySelector('input[name="correctOption"]:checked') as HTMLInputElement | null;
            buildOptionInputs(currentOpts, checkedRadio ? Number(checkedRadio.value) : 0, editQType?.value || 'quiz');
        });

        function buildSurveySubInputs(subQuestions: any[]) {
            if (!surveySubsBox) return;
            const list =
                subQuestions && subQuestions.length > 0
                    ? subQuestions
                    : [
                          { id: 'sq1', prompt: 'Avalie a sessão de 1 a 5 estrelas', type: 'rating', maxStars: 5 },
                          { id: 'sq2', prompt: 'O que mais gostou neste evento?', type: 'opentext' },
                      ];
            surveySubsBox.innerHTML = list
                .map(
                    (sq, idx) => `
                    <div class="survey-sub-row grid grid-cols-1 sm:grid-cols-12 gap-2 p-2.5 rounded-lg bg-gray-50 border border-gray-200 items-center">
                        <input
                            type="text"
                            value="${String(sq.prompt || '').replace(/"/g, '&quot;')}"
                            placeholder="Pergunta ${idx + 1} do questionário..."
                            class="sq-prompt sm:col-span-8 px-2.5 py-1.5 rounded border border-gray-300 text-xs font-semibold bg-white"
                        />
                        <select class="sq-type sm:col-span-3 px-2 py-1.5 rounded border border-gray-300 text-xs font-bold bg-white">
                            <option value="rating" ${sq.type === 'rating' ? 'selected' : ''}>⭐ Estrelas (1-5)</option>
                            <option value="opentext" ${sq.type === 'opentext' ? 'selected' : ''}>💬 Texto Aberto</option>
                        </select>
                        <button type="button" class="btn-del-sq sm:col-span-1 text-red-500 font-bold text-xs cursor-pointer">✕</button>
                    </div>
                `
                )
                .join('');

            surveySubsBox.querySelectorAll('.btn-del-sq').forEach((b) => {
                b.addEventListener('click', () => {
                    if (surveySubsBox.querySelectorAll('.survey-sub-row').length > 1) {
                        b.closest('.survey-sub-row')?.remove();
                    }
                });
            });
        }

        document.getElementById('btn-add-survey-sub')?.addEventListener('click', () => {
            const current: any[] = [];
            document.querySelectorAll('.survey-sub-row').forEach((row, i) => {
                current.push({
                    id: `sq${i + 1}`,
                    prompt: (row.querySelector('.sq-prompt') as HTMLInputElement)?.value || '',
                    type: (row.querySelector('.sq-type') as HTMLSelectElement)?.value || 'rating',
                });
            });
            current.push({ id: `sq${current.length + 1}`, prompt: '', type: 'rating' });
            buildSurveySubInputs(current);
        });

        function openQuestionEditor(q?: any) {
            if (!formQuestion || !editQId || !editQText || !editQType || !editQTime) return;
            formQuestion.classList.remove('hidden');
            formQuestion.classList.add('flex');
            const heading = document.getElementById('form-q-heading');

            if (q) {
                if (heading) heading.textContent = `Editar Atividade #${q.orderIndex + 1}`;
                editQId.value = q.id;
                editQText.value = q.text;
                editQTime.value = String(q.timeLimitSec || 20);
                if (editQMultiplier) editQMultiplier.value = String(q.pointsMultiplier || 1);
                if (editQImageUrl) editQImageUrl.value = q.imageUrl || '';
                if (editQImageReveal) editQImageReveal.value = q.imageRevealMode || 'none';
                if (editQMaxStars) editQMaxStars.value = String(q.config?.maxStars || 5);

                const opts = q.options && q.options.length > 0 ? q.options : ['', '', '', ''];
                buildOptionInputs(opts, q.correctIndex || 0, q.type || 'quiz');
                buildSurveySubInputs(q.config?.questions || []);
                selectInteractionModel(q.type || 'quiz');
            } else {
                if (heading) heading.textContent = 'Nova Atividade Interativa';
                editQId.value = '';
                editQText.value = '';
                editQTime.value = '25';
                if (editQMultiplier) editQMultiplier.value = '1';
                if (editQImageUrl) editQImageUrl.value = '';
                if (editQImageReveal) editQImageReveal.value = 'none';
                if (editQMaxStars) editQMaxStars.value = '5';
                buildOptionInputs(['', '', '', ''], 0, 'quiz');
                buildSurveySubInputs([]);
                selectInteractionModel('quiz');
            }
        }

        document.getElementById('btn-new-question-toggle')?.addEventListener('click', () =>
            openQuestionEditor()
        );
        document.getElementById('btn-cancel-q')?.addEventListener('click', () => {
            formQuestion?.classList.add('hidden');
            formQuestion?.classList.remove('flex');
        });

        formQuestion?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const qType = editQType?.value || 'quiz';
            const opts: string[] = [];
            document.querySelectorAll('.q-opt-input').forEach((inp) => {
                const v = (inp as HTMLInputElement).value.trim();
                if (v) opts.push(v);
            });
            const checkedRadio = document.querySelector(
                'input[name="correctOption"]:checked'
            ) as HTMLInputElement | null;
            const correctIndex = checkedRadio ? Number(checkedRadio.value) : 0;

            let config: any = {};
            if (qType === 'rating') {
                config = { maxStars: Number(editQMaxStars?.value || 5) };
            } else if (qType === 'survey') {
                const subQuestions: any[] = [];
                document.querySelectorAll('.survey-sub-row').forEach((row, idx) => {
                    const prompt = (row.querySelector('.sq-prompt') as HTMLInputElement)?.value.trim();
                    const type = (row.querySelector('.sq-type') as HTMLSelectElement)?.value || 'rating';
                    if (prompt) {
                        subQuestions.push({ id: `sq${idx + 1}`, prompt, type, maxStars: 5 });
                    }
                });
                config = { questions: subQuestions };
            }

            await sendHostCmd({
                action: 'save_question',
                questionId: editQId?.value || '',
                text: editQText?.value || '',
                type: qType,
                timeLimitSec: Number(editQTime?.value || 25),
                pointsMultiplier: qType === 'quiz' ? Number(editQMultiplier?.value || 1) : 1,
                imageUrl: qType === 'quiz' ? editQImageUrl?.value.trim() || '' : '',
                imageRevealMode: qType === 'quiz' ? editQImageReveal?.value || 'none' : 'none',
                options: opts,
                correctIndex,
                config,
            });
            formQuestion.classList.add('hidden');
            formQuestion.classList.remove('flex');
        });

        function renderLivePanel(state: any) {
            const statusLabels: Record<string, string> = {
                lobby: '📱 Lobby QR Code',
                question_open: '⏱️ Atividade em Direto',
                question_reveal: '✅ Resultado Revelado',
                leaderboard: state.leaderboardMode === 'teams' ? '🏪 Ranking Lojas FNAC' : '🏆 Classificação Individual',
                countdown_winners: '🎬 Top 10 Countdown',
            };
            const badge = document.getElementById('live-status-badge');
            if (badge) badge.textContent = statusLabels[state.status] || state.status;

            const pCount = document.getElementById('ctrl-participants-count');
            const curQ = document.getElementById('ctrl-current-q');
            const ansCount = document.getElementById('ctrl-answers-count');
            if (pCount) pCount.textContent = String(state.participantsCount || 0);
            if (curQ) {
                const totalQ = state.activeQuiz?.totalQuestions || 0;
                curQ.textContent = totalQ > 0 ? `${(state.currentQuestionIndex || 0) + 1} / ${totalQ}` : '0 / 0';
            }
            if (ansCount) ansCount.textContent = String(state.questionStats?.totalAnswers || 0);

            const autoLanEl = document.getElementById('auto-lan-url');
            if (autoLanEl) autoLanEl.textContent = `${state.autoDetectedUrl}/play`;

            const pubInput = document.getElementById('input-public-url') as HTMLInputElement | null;
            if (pubInput && document.activeElement !== pubInput) {
                pubInput.value = state.publicBaseUrl || '';
            }
            const chkImp = document.getElementById('chk-include-imported') as HTMLInputElement | null;
            if (chkImp) chkImp.checked = Boolean(state.includeImportedRounds);

            const rosterLbl = document.getElementById('roster-count-label');
            if (rosterLbl) rosterLbl.textContent = String(state.rosterCount || 0);

            // Renderizar Lista de Sessões
            const quizzesList = document.getElementById('quizzes-list');
            if (quizzesList) {
                quizzesList.innerHTML = (state.allQuizzes || [])
                    .map((q: any) => {
                        const isActive = q.id === state.activeQuizId;
                        return `
                            <div class="p-3 rounded-xl border ${
                                isActive
                                    ? 'border-[#141414] bg-amber-50/70'
                                    : 'border-gray-200 bg-gray-50'
                            } flex items-center justify-between gap-2 text-xs">
                                <div class="min-w-0">
                                    <span class="font-black bg-black text-[#FFCC00] px-2 py-0.5 rounded mr-1.5">#${q.code}</span>
                                    <strong class="text-gray-900">${q.title}</strong>
                                    <span class="text-gray-400 ml-1">(${q.questions.length} ativ. • ${q.answersCount} resp.)</span>
                                </div>
                                <div class="flex items-center gap-1.5 shrink-0">
                                    ${
                                        isActive
                                            ? `<span class="px-2 py-1 rounded bg-emerald-600 text-white font-bold">Ativo</span>`
                                            : `<button type="button" data-select-quiz="${q.id}" class="btn-select-quiz px-2.5 py-1 rounded bg-[#141414] text-white font-bold cursor-pointer">Ativar</button>`
                                    }
                                </div>
                            </div>
                        `;
                    })
                    .join('');

                document.querySelectorAll('.btn-select-quiz').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const quizId = (btn as HTMLElement).dataset.selectQuiz;
                        sendHostCmd({ action: 'select_quiz', quizId });
                    });
                });
            }

            // Renderizar Playlist de Atividades da Sessão Ativa
            const activeFullQuiz = (state.allQuizzes || []).find(
                (q: any) => q.id === state.activeQuizId
            );
            const editorTitle = document.getElementById('editor-quiz-title');
            if (editorTitle && activeFullQuiz) {
                editorTitle.textContent = `${activeFullQuiz.title} (${activeFullQuiz.questions.length} atividades)`;
            }

            const qListEl = document.getElementById('questions-list');
            if (qListEl && activeFullQuiz) {
                const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
                qListEl.innerHTML = activeFullQuiz.questions
                    .map((q: any, idx: number) => {
                        const isCurrent =
                            idx === state.currentQuestionIndex &&
                            (state.status === 'question_open' || state.status === 'question_reveal');
                        const qType = q.type || 'quiz';
                        const meta = MODEL_META[qType] || MODEL_META.quiz;

                        let detailsHtml = '';
                        if (qType === 'quiz' || qType === 'boolean' || qType === 'poll' || qType === 'ranking') {
                            detailsHtml = `<div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs">
                                ${(q.options || [])
                                    .map(
                                        (opt: string, oIdx: number) => `
                                        <div class="px-3 py-1.5 rounded-lg border ${
                                            (qType === 'quiz' || qType === 'boolean') && oIdx === q.correctIndex
                                                ? 'border-emerald-500 bg-emerald-50 text-emerald-900 font-bold'
                                                : 'border-gray-200 bg-white text-gray-600'
                                        }">
                                            <strong>${qType === 'ranking' ? `#${oIdx + 1}` : letters[oIdx] || oIdx + 1}:</strong> ${opt}
                                            ${(qType === 'quiz' || qType === 'boolean') && oIdx === q.correctIndex ? ' ✓' : ''}
                                        </div>
                                    `
                                    )
                                    .join('')}
                            </div>`;
                        } else if (qType === 'survey') {
                            const subs = q.config?.questions || [];
                            detailsHtml = `<p class="text-xs text-gray-500">📋 ${subs.length} sub-perguntas configuradas no Survey</p>`;
                        } else if (qType === 'rating') {
                            detailsHtml = `<p class="text-xs text-gray-500">⭐ Avaliação de 1 a ${q.config?.maxStars || 5} estrelas</p>`;
                        }

                        return `
                            <div class="p-4 rounded-2xl border ${
                                isCurrent
                                    ? 'border-2 border-[#D93805] bg-amber-50/40 shadow-sm'
                                    : 'border-gray-200 bg-gray-50/60'
                            } flex flex-col gap-2.5">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <div class="flex flex-wrap items-center gap-1.5">
                                            <span class="text-xs font-black uppercase px-2 py-0.5 rounded bg-black text-[#FFCC00]">
                                                #${idx + 1}
                                            </span>
                                            <span class="text-[11px] font-extrabold px-2.5 py-0.5 rounded-full ${meta.color}">
                                                ${meta.badge}
                                            </span>
                                            ${
                                                Number(q.pointsMultiplier) > 1
                                                    ? `<span class="text-[11px] font-black px-2 py-0.5 rounded-full bg-red-600 text-white">🔥 2x Pontos</span>`
                                                    : ''
                                            }
                                            ${
                                                q.imageUrl
                                                    ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-900">🖼️ Imagem (${q.imageRevealMode || 'none'})</span>`
                                                    : ''
                                            }
                                            <span class="text-xs text-gray-500 font-semibold">⏱️ ${q.timeLimitSec}s</span>
                                        </div>
                                        <h4 class="font-bold text-base text-[#111111] mt-1.5">${q.text}</h4>
                                    </div>
                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <button
                                            type="button"
                                            data-launch-idx="${idx}"
                                            class="btn-launch-q bg-[#D93805] hover:bg-[#b82e03] text-white text-xs font-extrabold px-3 py-1.5 rounded-lg cursor-pointer"
                                        >
                                            ▶️ Lançar no Palco
                                        </button>
                                        <button
                                            type="button"
                                            data-edit-idx="${idx}"
                                            class="btn-edit-q bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-bold px-2.5 py-1.5 rounded-lg cursor-pointer"
                                        >
                                            ✏️
                                        </button>
                                        <button
                                            type="button"
                                            data-del-id="${q.id}"
                                            class="btn-del-q bg-white border border-gray-300 hover:bg-red-50 text-red-600 text-xs font-bold px-2.5 py-1.5 rounded-lg cursor-pointer"
                                        >
                                            🗑️
                                        </button>
                                    </div>
                                </div>
                                ${detailsHtml}
                            </div>
                        `;
                    })
                    .join('');

                document.querySelectorAll('.btn-launch-q').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const idx = Number((btn as HTMLElement).dataset.launchIdx);
                        sendHostCmd({ action: 'open_question', questionIndex: idx });
                    });
                });

                document.querySelectorAll('.btn-edit-q').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const idx = Number((btn as HTMLElement).dataset.editIdx);
                        openQuestionEditor(activeFullQuiz.questions[idx]);
                    });
                });

                document.querySelectorAll('.btn-del-q').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const questionId = (btn as HTMLElement).dataset.delId;
                        if (confirm('Apagar esta atividade da playlist?')) {
                            sendHostCmd({ action: 'delete_question', questionId });
                        }
                    });
                });
            }
        }

        // === Lógica da Aba 2: Importação Excel/CSV & Unificação de Utilizadores ===
        const btnModeMerge = document.getElementById('mode-merge');
        const btnModeReplace = document.getElementById('mode-replace');
        btnModeMerge?.addEventListener('click', () => {
            uploadMode = 'merge';
            btnModeMerge.className = 'py-2 px-3 rounded-lg bg-[#141414] text-[#FFCC00] shadow-sm transition cursor-pointer';
            if (btnModeReplace) btnModeReplace.className = 'py-2 px-3 rounded-lg text-gray-600 hover:text-black transition cursor-pointer';
        });
        btnModeReplace?.addEventListener('click', () => {
            uploadMode = 'replace';
            btnModeReplace.className = 'py-2 px-3 rounded-lg bg-[#141414] text-[#FFCC00] shadow-sm transition cursor-pointer';
            if (btnModeMerge) btnModeMerge.className = 'py-2 px-3 rounded-lg text-gray-600 hover:text-black transition cursor-pointer';
        });

        function showAlert(message: string, isError = false) {
            const alertEl = document.getElementById('upload-alert');
            if (!alertEl) return;
            alertEl.className = `mt-4 p-3.5 rounded-xl text-sm font-semibold ${
                isError ? 'bg-red-50 text-red-800 border border-red-200' : 'bg-emerald-50 text-emerald-900 border border-emerald-200'
            }`;
            alertEl.textContent = message;
            alertEl.classList.remove('hidden');
        }

        function fileToBase64(file: File): Promise<string> {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => {
                    const result = reader.result as string;
                    resolve(result.includes(',') ? result.split(',')[1] : result);
                };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        async function handleFilesUpload(files: FileList | null) {
            if (!files || files.length === 0) return;
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const contentBase64 = await fileToBase64(file);
                const res = await fetch('/api/upload', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fileName: file.name,
                        contentBase64,
                        mode: i === 0 ? uploadMode : 'merge',
                    }),
                });
                const data = await res.json();
                if (res.ok) {
                    showAlert(`✅ ${data.message}`, false);
                    await pollAdminState();
                } else {
                    showAlert(data.error || 'Erro ao carregar ficheiro.', true);
                }
            }
        }

        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
        dropzone?.addEventListener('dragover', (e) => e.preventDefault());
        dropzone?.addEventListener('drop', (e) => {
            e.preventDefault();
            if (e.dataTransfer?.files) handleFilesUpload(e.dataTransfer.files);
        });
        fileInput?.addEventListener('change', () => {
            handleFilesUpload(fileInput.files);
            fileInput.value = '';
        });

        function updateSelectionBarUI() {
            const bar = document.getElementById('manual-selection-bar');
            const countLabel = document.getElementById('selection-count-label');
            const previewEl = document.getElementById('selection-names-preview');
            const selectTarget = document.getElementById('select-target-name') as HTMLSelectElement | null;
            if (!bar || !countLabel || !previewEl || !selectTarget) return;

            if (selectedKeys.size < 2) {
                bar.classList.add('hidden');
                return;
            }
            bar.classList.remove('hidden');
            countLabel.textContent = `${selectedKeys.size} selecionados:`;
            const entries = Array.from(selectedKeys.entries());
            previewEl.textContent = entries.map(([, name]) => name).join(' + ');
            selectTarget.innerHTML = entries
                .map(([key, name]) => `<option value="${key}">Nome final: ${name}</option>`)
                .join('');
        }

        document.getElementById('btn-clear-selection')?.addEventListener('click', () => {
            selectedKeys.clear();
            updateSelectionBarUI();
            renderTableRows((document.getElementById('search-player') as HTMLInputElement)?.value || '');
        });

        document.getElementById('btn-merge-selected')?.addEventListener('click', async () => {
            const selectTarget = document.getElementById('select-target-name') as HTMLSelectElement | null;
            if (!selectTarget || selectedKeys.size < 2) return;
            const targetKey = selectTarget.value;
            const displayName = selectedKeys.get(targetKey) || targetKey;
            const sourceKeys = Array.from(selectedKeys.keys());
            const sourceLabels: Record<string, string> = {};
            selectedKeys.forEach((name, key) => (sourceLabels[key] = name));

            const res = await fetch('/api/settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    action: 'mergeUsers',
                    targetKey,
                    displayName,
                    sourceKeys,
                    sourceLabels,
                }),
            });
            if (res.ok) {
                selectedKeys.clear();
                updateSelectionBarUI();
                await pollAdminState();
            }
        });

        document.querySelectorAll('.limit-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const limit = Number((btn as HTMLElement).dataset.limit);
                await fetch('/api/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ topLimit: limit }),
                });
                await pollAdminState();
            });
        });

        function renderTableRows(filterText = '') {
            const tbody = document.getElementById('admin-table-body');
            if (!tbody) return;
            const query = filterText.trim().toLocaleLowerCase('pt-PT');
            const filtered = query
                ? allStandings.filter((p) => p.name.toLocaleLowerCase('pt-PT').includes(query))
                : allStandings;

            tbody.innerHTML = filtered
                .map((p) => {
                    const isTop = p.position <= activeTopLimit;
                    const isChecked = selectedKeys.has(p.key);
                    return `
                        <tr class="${isChecked ? 'bg-amber-100/70' : isTop ? 'bg-amber-50/40' : 'hover:bg-gray-50'}">
                            <td class="py-2.5 px-3 text-center">
                                <input type="checkbox" data-key="${p.key}" data-name="${p.name}" ${isChecked ? 'checked' : ''} class="player-checkbox w-4 h-4 accent-[#141414] rounded cursor-pointer" />
                            </td>
                            <td class="py-2.5 px-3 font-bold">#${p.position}</td>
                            <td class="py-2.5 px-4 font-medium">
                                ${p.name}
                                ${p.teamName ? `<span class="ml-1.5 text-[11px] px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-semibold">${p.teamName}</span>` : ''}
                            </td>
                            <td class="py-2.5 px-3 text-center">${p.entriesCount || 1}x</td>
                            <td class="py-2.5 px-4 text-right font-bold tabular-nums">${p.score} <span class="text-xs font-normal text-gray-400">/ ${p.maxScore || 12}</span></td>
                            <td class="py-2.5 px-4 text-right font-semibold tabular-nums">${p.displayTime}</td>
                            <td class="py-2.5 px-4 text-right text-xs text-gray-400 tabular-nums">${p.timeMs} ms</td>
                        </tr>
                    `;
                })
                .join('');

            document.querySelectorAll('.player-checkbox').forEach((cb) => {
                cb.addEventListener('change', (e) => {
                    const target = e.currentTarget as HTMLInputElement;
                    const key = target.dataset.key || '';
                    const name = target.dataset.name || key;
                    if (target.checked) selectedKeys.set(key, name);
                    else selectedKeys.delete(key);
                    updateSelectionBarUI();
                });
            });
        }

        document.getElementById('search-player')?.addEventListener('input', (e) => {
            renderTableRows((e.currentTarget as HTMLInputElement).value);
        });

        function renderSlidoPanel(lb: any) {
            if (!lb) return;
            allStandings = lb.standings || [];
            activeTopLimit = lb.topLimit || 5;

            document.querySelectorAll('.limit-btn').forEach((btn) => {
                const l = Number((btn as HTMLElement).dataset.limit);
                btn.className =
                    l === activeTopLimit
                        ? 'limit-btn py-2 rounded-lg font-bold text-sm border bg-[#141414] text-[#FFCC00] border-[#141414] cursor-pointer'
                        : 'limit-btn py-2 rounded-lg font-bold text-sm border border-gray-200 bg-white text-gray-700 cursor-pointer';
            });

            const summary = document.getElementById('admin-summary');
            if (summary) summary.textContent = `${lb.totalParticipants} participantes classificados`;

            const autoBadge = document.getElementById('auto-unified-badge');
            if (autoBadge) autoBadge.textContent = `${(lb.autoUnifiedList || []).length} unificados`;

            const suggestionsList = document.getElementById('suggestions-list');
            const suggestions = lb.suggestedMerges || [];
            if (suggestionsList) {
                suggestionsList.innerHTML =
                    suggestions.length === 0
                        ? `<p class="text-xs text-gray-400">Sem sugestões pendentes.</p>`
                        : suggestions
                              .map(
                                  (s: any) => `
                            <div class="p-2.5 rounded-xl bg-gray-50 border border-gray-200 flex items-center justify-between gap-2 text-xs">
                                <div>
                                    <strong>${s.playerA.name}</strong> + <strong>${s.playerB.name}</strong>
                                    <span class="text-gray-400 ml-1">(${s.combinedScore} certas)</span>
                                </div>
                                <button
                                    type="button"
                                    data-target-key="${s.playerA.key}"
                                    data-target-name="${s.playerA.name}"
                                    data-source-key="${s.playerB.key}"
                                    data-source-name="${s.playerB.name}"
                                    class="btn-accept-sug bg-[#141414] text-[#FFCC00] font-bold px-2.5 py-1 rounded-lg cursor-pointer shrink-0"
                                >
                                    🔗 Unificar
                                </button>
                            </div>
                        `
                              )
                              .join('');

                document.querySelectorAll('.btn-accept-sug').forEach((btn) => {
                    btn.addEventListener('click', async () => {
                        const el = btn as HTMLElement;
                        const tKey = el.dataset.targetKey || '';
                        const tName = el.dataset.targetName || '';
                        const sKey = el.dataset.sourceKey || '';
                        const sName = el.dataset.sourceName || '';
                        const displayName = sName.length > tName.length ? sName : tName;
                        await fetch('/api/settings', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                action: 'mergeUsers',
                                targetKey: tKey,
                                displayName,
                                sourceKeys: [tKey, sKey],
                                sourceLabels: { [sKey]: sName, [tKey]: tName },
                            }),
                        });
                        await pollAdminState();
                    });
                });
            }

            renderTableRows((document.getElementById('search-player') as HTMLInputElement)?.value || '');
        }

        function renderAll(data: any) {
            latestLiveState = data;
            renderLivePanel(data);
            if (data.leaderboard) {
                renderSlidoPanel(data.leaderboard);
            }
        }

        async function pollAdminState() {
            try {
                const res = await fetch(`/api/live/state?t=${Date.now()}`, { cache: 'no-store' });
                if (res.ok) {
                    const data = await res.json();
                    renderAll(data);
                }
            } catch (e) {
                console.error(e);
            }
        }

        pollAdminState();
        setInterval(pollAdminState, 2000);
    </script>
</body>
</html>
