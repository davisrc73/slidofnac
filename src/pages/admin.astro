---
// src/pages/admin.astro — Backoffice, Comando em Tempo Real & Criador dos 8 Modelos Interativos Slido
---
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Backoffice & Comando Ao Vivo — Plataforma Interativa FNAC</title>
</head>
<body class="bg-[#F6F4EF] min-h-screen font-sans text-[#141414]">

    <!-- Barra de Topo -->
    <header class="bg-[#141414] text-white border-b border-white/10 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-6 py-3.5 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="bg-[#FFCC00] text-black font-black tracking-tighter text-xl px-3 py-0.5 rounded uppercase">
                    fnac
                </div>
                <div>
                    <h1 class="font-bold text-base md:text-lg leading-tight">Plataforma Interativa de Quizzes & Eventos</h1>
                    <p class="text-xs text-gray-400">8 Modelos Slido • Batalha de Lojas FNAC • Exportação Excel</p>
                </div>
            </div>

            <!-- Navegação de Abas + Links Rápidos + Exportar Excel -->
            <div class="flex flex-wrap items-center gap-2">
                <div class="bg-white/10 p-1 rounded-xl flex items-center gap-1 mr-1">
                    <button
                        id="tab-btn-live"
                        type="button"
                        class="px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-[#FFCC00] text-black transition cursor-pointer"
                    >
                        🎮 Atividades Ao Vivo (8 Modelos)
                    </button>
                    <button
                        id="tab-btn-slido"
                        type="button"
                        class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-gray-300 hover:text-white transition cursor-pointer"
                    >
                        📊 Importar Excel & Unificar Nomes
                    </button>
                </div>

                <button
                    id="btn-open-manuals"
                    type="button"
                    class="inline-flex items-center gap-1.5 bg-white/15 hover:bg-white/25 text-[#FFCC00] font-bold text-xs px-3.5 py-2 rounded-lg transition cursor-pointer border border-[#FFCC00]/30"
                    title="Abrir Manuais de Operação, Guia dos 8 Modelos e Runbook de Evento"
                >
                    <span>📖 Manuais & Runbook</span>
                </button>
                <a
                    href="/api/live/export.xlsx"
                    class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs px-3.5 py-2 rounded-lg transition shadow"
                    title="Exportar Classificação Individual, Lojas FNAC e todas as respostas para Excel (.xlsx)"
                >
                    <span>📥 Exportar .XLSX</span>
                </a>
                <a
                    href="/stage"
                    target="_blank"
                    class="inline-flex items-center gap-1.5 bg-[#D93805] hover:bg-[#b82e03] text-white font-bold text-xs px-3.5 py-2 rounded-lg transition shadow"
                >
                    <span>📡 Palco (/stage)</span>
                    <span>↗</span>
                </a>
                <a
                    href="/play"
                    target="_blank"
                    class="inline-flex items-center gap-1.5 bg-white/10 hover:bg-white/20 text-white font-bold text-xs px-3 py-2 rounded-lg transition"
                >
                    <span>📱 Mobile (/play)</span>
                    <span>↗</span>
                </a>
                <a
                    href="/vencedores"
                    target="_blank"
                    class="inline-flex items-center gap-1.5 bg-white/10 hover:bg-white/20 text-[#FFCC00] font-bold text-xs px-3 py-2 rounded-lg transition"
                >
                    <span>🎬 Top 10 (/vencedores)</span>
                    <span>↗</span>
                </a>
                <a
                    href="/"
                    target="_blank"
                    class="inline-flex items-center gap-1.5 bg-[#FFCC00] hover:bg-[#ffd633] text-black font-bold text-xs px-3 py-2 rounded-lg transition"
                >
                    <span>🏆 Tabela (/)</span>
                    <span>↗</span>
                </a>
            </div>
        </div>
    </header>

    <!-- ABA 1: COMANDO AO VIVO & CRIADOR DOS 8 MODELOS SLIDO -->
    <main id="tab-panel-live" class="max-w-7xl mx-auto px-6 py-7 grid grid-cols-1 lg:grid-cols-12 gap-7">

        <!-- Coluna Esquerda (5 cols): Telecomando em Direto + Rede QR + Lista de Sessões -->
        <div class="lg:col-span-5 flex flex-col gap-6">

            <!-- Cartão 1: Telecomando do Palco em Tempo Real -->
            <section class="bg-white rounded-2xl p-6 shadow-sm border-2 border-[#141414]">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-extrabold flex items-center gap-2">
                        <span>📡</span> Telecomando do Palco
                    </h2>
                    <span id="live-status-badge" class="text-xs font-extrabold uppercase px-3 py-1 rounded-full bg-amber-100 text-amber-900">
                        Lobby QR
                    </span>
                </div>

                <!-- Métricas em Tempo Real -->
                <div class="grid grid-cols-3 gap-2.5 mb-4 text-center">
                    <div class="bg-gray-50 rounded-xl p-2.5 border border-gray-200">
                        <p class="text-[10px] font-bold uppercase text-gray-400">Em Sala</p>
                        <p id="ctrl-participants-count" class="text-2xl font-black text-[#141414]">0</p>
                    </div>
                    <div class="bg-gray-50 rounded-xl p-2.5 border border-gray-200">
                        <p class="text-[10px] font-bold uppercase text-gray-400">Atividade Atual</p>
                        <p id="ctrl-current-q" class="text-2xl font-black text-[#D93805]">1 / 8</p>
                    </div>
                    <div class="bg-gray-50 rounded-xl p-2.5 border border-gray-200">
                        <p class="text-[10px] font-bold uppercase text-gray-400">Participações</p>
                        <p id="ctrl-answers-count" class="text-2xl font-black text-emerald-700">0</p>
                    </div>
                </div>

                <!-- Botões Principais de Controlo do Fluxo -->
                <div class="grid grid-cols-2 gap-2.5 mb-3">
                    <button
                        type="button"
                        id="btn-cmd-lobby"
                        class="py-2.5 px-3 rounded-xl font-bold text-xs bg-gray-100 hover:bg-gray-200 text-gray-900 transition cursor-pointer"
                    >
                        📱 1. Mostrar QR Lobby
                    </button>
                    <button
                        type="button"
                        id="btn-cmd-open-q"
                        class="py-2.5 px-3 rounded-xl font-extrabold text-xs bg-[#D93805] hover:bg-[#b82e03] text-white transition cursor-pointer"
                    >
                        ▶️ 2. Abrir Atividade Atual
                    </button>
                    <button
                        type="button"
                        id="btn-cmd-reveal"
                        class="py-2.5 px-3 rounded-xl font-extrabold text-xs bg-emerald-600 hover:bg-emerald-700 text-white transition cursor-pointer"
                    >
                        ✅ 3. Revelar / Fechar Votação
                    </button>
                    <button
                        type="button"
                        id="btn-cmd-next-q"
                        class="py-2.5 px-3 rounded-xl font-extrabold text-xs bg-[#141414] hover:bg-black text-[#FFCC00] transition cursor-pointer"
                    >
                        ⏭️ 4. Próxima Atividade
                    </button>
                </div>

                <!-- Botões de Classificação: Individual vs Lojas FNAC -->
                <div class="grid grid-cols-2 gap-2.5 pt-2 border-t border-gray-100 mb-2.5">
                    <button
                        type="button"
                        id="btn-cmd-leaderboard"
                        class="py-2.5 px-3 rounded-xl font-extrabold text-xs bg-[#FFCC00] hover:bg-[#f0b72b] text-black transition cursor-pointer"
                    >
                        🏆 Ranking Individual
                    </button>
                    <button
                        type="button"
                        id="btn-cmd-teams-leaderboard"
                        class="py-2.5 px-3 rounded-xl font-extrabold text-xs bg-amber-100 hover:bg-amber-200 text-amber-950 border border-amber-300 transition cursor-pointer"
                    >
                        🏪 Batalha de Lojas FNAC
                    </button>
                </div>

                <div class="grid grid-cols-2 gap-2.5 pt-2 border-t border-gray-100">
                    <a
                        href="/api/live/export.xlsx"
                        class="py-2 px-3 rounded-xl font-bold text-xs bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-center transition"
                    >
                        📥 Exportar Tudo (.XLSX)
                    </a>
                    <button
                        type="button"
                        id="btn-cmd-reset-answers"
                        class="py-2 px-3 rounded-xl font-semibold text-xs bg-red-50 hover:bg-red-100 text-red-700 transition cursor-pointer"
                        title="Apaga as respostas desta sessão para começar do zero"
                    >
                        🗑️ Zerar Respostas
                    </button>
                </div>
            </section>

            <!-- Cartão 2: Selecionar / Criar Sessão (Playlist de Atividades) -->
            <section class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-extrabold flex items-center gap-2">
                        <span>📚</span> Sessões / Playlists
                    </h2>
                </div>

                <div id="quizzes-list" class="flex flex-col gap-2 mb-4"></div>

                <details class="pt-3 border-t border-gray-100">
                    <summary class="text-xs font-extrabold text-[#D93805] cursor-pointer">
                        ➕ Criar Nova Sessão / Playlist
                    </summary>
                    <form id="form-new-quiz" class="mt-3 flex flex-col gap-2.5">
                        <div class="grid grid-cols-3 gap-2">
                            <input
                                id="new-quiz-code"
                                type="text"
                                placeholder="PIN (ex: FNAC26)"
                                required
                                class="col-span-1 px-3 py-2 rounded-lg border border-gray-300 text-xs font-bold uppercase"
                            />
                            <input
                                id="new-quiz-title"
                                type="text"
                                placeholder="Título da Sessão / Convenção"
                                required
                                class="col-span-2 px-3 py-2 rounded-lg border border-gray-300 text-xs font-semibold"
                            />
                        </div>
                        <button
                            type="submit"
                            class="bg-[#141414] text-[#FFCC00] font-bold text-xs py-2 rounded-lg cursor-pointer"
                        >
                            Criar Sessão
                        </button>
                    </form>
                </details>
            </section>

            <!-- Cartão 3: Ligação Mobile (QR Code Wi-Fi / Cloud) & Lista de Colaboradores -->
            <section class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                <h2 class="text-lg font-extrabold flex items-center gap-2 mb-2">
                    <span>🌐</span> Acesso Telemóveis (QR Code)
                </h2>
                <p class="text-xs text-gray-500 mb-3">
                    Por defeito usa o IP Wi-Fi local do seu Mac (<code id="auto-lan-url" class="font-bold text-gray-800"></code>). Se usar um túnel público/Cloud (4G/5G), cole o endereço abaixo:
                </p>

                <div class="flex gap-2 mb-4">
                    <input
                        id="input-public-url"
                        type="text"
                        placeholder="Vazio = usar IP Wi-Fi automático do Mac"
                        class="flex-1 px-3 py-2 rounded-xl border border-gray-300 text-xs font-medium"
                    />
                    <button
                        id="btn-save-url"
                        type="button"
                        class="bg-[#141414] text-white px-3.5 py-2 rounded-xl text-xs font-bold cursor-pointer shrink-0"
                    >
                        Guardar
                    </button>
                </div>

                <label class="flex items-center gap-2 text-xs font-semibold text-gray-700 cursor-pointer mb-4">
                    <input id="chk-include-imported" type="checkbox" class="w-4 h-4 accent-[#141414] rounded" />
                    <span>Combinar pontos dos Quizzes Ao Vivo com ficheiros Excel importados</span>
                </label>

                <details class="pt-3 border-t border-gray-100 text-xs">
                    <summary class="font-bold text-gray-700 cursor-pointer">
                        👥 Lista Autocomplete de Participantes (<span id="roster-count-label">0</span> nomes)
                    </summary>
                    <p class="text-gray-500 mt-1.5 mb-2">
                        Adicione nomes (1 por linha) para aparecerem como sugestão automática no telemóvel dos participantes:
                    </p>
                    <textarea
                        id="textarea-roster"
                        rows="3"
                        placeholder="João Silva&#10;Maria Santos"
                        class="w-full p-2.5 rounded-lg border border-gray-300 text-xs mb-2"
                    ></textarea>
                    <button
                        id="btn-add-roster"
                        type="button"
                        class="bg-gray-800 text-white font-bold px-3 py-1.5 rounded-lg cursor-pointer"
                    >
                        Adicionar à Lista de Autocomplete
                    </button>
                </details>
            </section>
        </div>

        <!-- Coluna Direita (7 cols): Grelha Visual dos 8 Modelos Slido + Playlist de Atividades -->
        <div class="lg:col-span-7 flex flex-col gap-6">
            <section class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200 flex-1 flex flex-col">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-[#D93805]">Playlist da Sessão Ativa</span>
                        <h2 id="editor-quiz-title" class="text-xl font-extrabold text-[#111111]">
                            Atividades & Perguntas
                        </h2>
                    </div>
                    <button
                        id="btn-new-question-toggle"
                        type="button"
                        class="bg-[#FFCC00] hover:bg-[#f0b72b] text-black font-extrabold text-xs px-4 py-2.5 rounded-xl shadow-sm transition cursor-pointer"
                    >
                        ➕ Adicionar Interação (8 Modelos)
                    </button>
                </div>

                <!-- SELETOR VISUAL DOS 8 MODELOS SLIDO + FORMULÁRIO DE CONFIGURAÇÃO -->
                <form
                    id="form-question"
                    class="hidden mb-6 p-5 rounded-2xl bg-[#FAF8F5] border-2 border-[#141414] flex-col gap-4 shadow-md"
                >
                    <div class="flex items-center justify-between">
                        <h3 id="form-q-heading" class="font-extrabold text-base text-[#111111]">
                            Escolher Modelo de Interação
                        </h3>
                        <button
                            type="button"
                            id="btn-cancel-q"
                            class="text-xs font-bold text-gray-500 hover:text-black cursor-pointer"
                        >
                            ✕ Fechar
                        </button>
                    </div>

                    <input type="hidden" id="edit-q-id" value="" />
                    <input type="hidden" id="edit-q-type" value="quiz" />

                    <!-- Grelha Visual de 8 Cartões (Idêntica ao Slido) -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
                            1. Modelo de Interação
                        </label>
                        <div id="model-cards-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                            <!-- Multiple choice (Poll) -->
                            <button type="button" data-model="poll" class="model-card-btn group text-left p-2.5 rounded-xl border border-gray-200 bg-white hover:border-[#2563EB] transition cursor-pointer flex flex-col justify-between">
                                <div class="bg-[#F3F4F6] rounded-lg p-2.5 mb-2 flex flex-col gap-1.5">
                                    <div class="h-2 w-4/5 rounded-full bg-[#2563EB]"></div>
                                    <div class="h-2 w-2/5 rounded-full bg-[#2563EB]"></div>
                                    <div class="h-2 w-3/5 rounded-full bg-[#2563EB]"></div>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs font-bold text-gray-800">
                                    <span class="text-[#2563EB]">☑️</span>
                                    <span>Multiple choice</span>
                                </div>
                            </button>

                            <!-- Word cloud -->
                            <button type="button" data-model="wordcloud" class="model-card-btn group text-left p-2.5 rounded-xl border border-gray-200 bg-white hover:border-[#7C3AED] transition cursor-pointer flex flex-col justify-between">
                                <div class="bg-[#F3F4F6] rounded-lg p-2.5 mb-2 flex flex-wrap items-center justify-center gap-1">
                                    <span class="h-2.5 w-8 rounded bg-[#9333EA]/60"></span>
                                    <span class="h-3.5 w-12 rounded bg-[#6B21A8]"></span>
                                    <span class="h-2.5 w-7 rounded bg-[#C084FC]"></span>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs font-bold text-gray-800">
                                    <span class="text-[#7C3AED]">☁️</span>
                                    <span>Word cloud</span>
                                </div>
                            </button>

                            <!-- Open text -->
                            <button type="button" data-model="opentext" class="model-card-btn group text-left p-2.5 rounded-xl border border-gray-200 bg-white hover:border-[#0D9488] transition cursor-pointer flex flex-col justify-between">
                                <div class="bg-[#F3F4F6] rounded-lg p-2.5 mb-2 flex flex-col gap-1.5">
                                    <div class="h-3 w-full rounded bg-[#0D9488]"></div>
                                    <div class="h-2.5 w-4/5 rounded bg-gray-300"></div>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs font-bold text-gray-800">
                                    <span class="text-[#0D9488]">💬</span>
                                    <span>Open text</span>
                                </div>
                            </button>

                            <!-- Ideas -->
                            <button type="button" data-model="ideas" class="model-card-btn group text-left p-2.5 rounded-xl border border-gray-200 bg-white hover:border-[#65A30D] transition cursor-pointer flex flex-col justify-between">
                                <div class="bg-[#F3F4F6] rounded-lg p-2.5 mb-2 flex flex-col gap-1.5">
                                    <div class="h-3 w-full rounded bg-[#65A30D]"></div>
                                    <div class="h-2.5 w-full rounded bg-gray-300"></div>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs font-bold text-gray-800">
                                    <span class="text-[#65A30D]">💡</span>
                                    <span>Ideas</span>
                                </div>
                            </button>

                            <!-- Ranking -->
                            <button type="button" data-model="ranking" class="model-card-btn group text-left p-2.5 rounded-xl border border-gray-200 bg-white hover:border-[#DB2777] transition cursor-pointer flex flex-col justify-between">
                                <div class="bg-[#F3F4F6] rounded-lg p-2.5 mb-2 flex flex-col gap-1.5">
                                    <div class="h-2 w-5/6 rounded-full bg-[#DB2777]"></div>
                                    <div class="h-2 w-4/6 rounded-full bg-[#DB2777]/80"></div>
                                    <div class="h-2 w-2/6 rounded-full bg-[#DB2777]/60"></div>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs font-bold text-gray-800">
                                    <span class="text-[#DB2777]">🏅</span>
                                    <span>Ranking</span>
                                </div>
                            </button>

                            <!-- Rating -->
                            <button type="button" data-model="rating" class="model-card-btn group text-left p-2.5 rounded-xl border border-gray-200 bg-white hover:border-[#EAB308] transition cursor-pointer flex flex-col justify-between">
                                <div class="bg-[#F3F4F6] rounded-lg p-2.5 mb-2 flex items-end justify-center gap-1.5 h-11">
                                    <div class="w-2.5 h-3 bg-gray-300 rounded-t"></div>
                                    <div class="w-2.5 h-5 bg-gray-300 rounded-t"></div>
                                    <div class="w-2.5 h-6 bg-gray-300 rounded-t"></div>
                                    <div class="w-2.5 h-8 bg-[#EAB308] rounded-t"></div>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs font-bold text-gray-800">
                                    <span class="text-[#CA8A04]">⭐</span>
                                    <span>Rating</span>
                                </div>
                            </button>

                            <!-- Quiz -->
                            <button type="button" data-model="quiz" class="model-card-btn group text-left p-2.5 rounded-xl border-2 border-[#D93805] bg-amber-50/60 transition cursor-pointer flex flex-col justify-between">
                                <div class="bg-[#F3F4F6] rounded-lg p-2 mb-2 flex flex-col items-center gap-1">
                                    <span class="text-[10px]">🏆</span>
                                    <div class="h-2.5 w-full rounded bg-[#D93805]"></div>
                                    <div class="h-2 w-full rounded bg-gray-300"></div>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs font-extrabold text-[#D93805]">
                                    <span>🏆</span>
                                    <span>Quiz</span>
                                </div>
                            </button>

                            <!-- Survey -->
                            <button type="button" data-model="survey" class="model-card-btn group text-left p-2.5 rounded-xl border border-gray-200 bg-white hover:border-gray-600 transition cursor-pointer flex flex-col justify-between">
                                <div class="bg-[#F3F4F6] rounded-lg p-2 mb-2 grid grid-cols-2 gap-1">
                                    <div class="h-3 bg-[#2563EB]/40 rounded"></div>
                                    <div class="h-3 bg-[#EAB308]/50 rounded"></div>
                                    <div class="h-3 bg-[#7C3AED]/40 rounded"></div>
                                    <div class="h-3 bg-[#DB2777]/40 rounded"></div>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs font-bold text-gray-800">
                                    <span>📋</span>
                                    <span>Survey</span>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Enunciado e Tempo -->
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                        <div class="sm:col-span-3">
                            <label class="block text-xs font-bold text-gray-600 mb-1">2. Pergunta / Título da Atividade</label>
                            <input
                                id="edit-q-text"
                                type="text"
                                required
                                placeholder="Escreva aqui o enunciado..."
                                class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 text-sm font-semibold bg-white"
                            />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 mb-1">Tempo (Segundos)</label>
                            <input
                                id="edit-q-time"
                                type="number"
                                min="5"
                                max="600"
                                value="20"
                                class="w-full px-3 py-2.5 rounded-xl border border-gray-300 text-sm font-bold bg-white"
                            />
                        </div>
                    </div>

                    <!-- Opções Extra de Quiz (2x Pontos Duplos + Imagem com Reveal Blur/Zoom) -->
                    <div id="quiz-extra-settings" class="grid grid-cols-1 sm:grid-cols-3 gap-3 p-3.5 rounded-xl bg-amber-50/80 border border-amber-200">
                        <div>
                            <label class="block text-[11px] font-bold text-amber-950 mb-1">🔥 Multiplicador de Pontos</label>
                            <select id="edit-q-multiplier" class="w-full px-3 py-2 rounded-lg border border-amber-300 text-xs font-bold bg-white">
                                <option value="1">1x Pontuação Normal (1 pt)</option>
                                <option value="2">🔥 2x Pontos Duplos (2 pts)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-amber-950 mb-1">🖼️ URL de Imagem (Opcional)</label>
                            <input
                                id="edit-q-image-url"
                                type="text"
                                placeholder="https://... ou /imagem.jpg"
                                class="w-full px-3 py-2 rounded-lg border border-amber-300 text-xs bg-white"
                            />
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-amber-950 mb-1">✨ Efeito Imagem Misteriosa</label>
                            <select id="edit-q-image-reveal" class="w-full px-3 py-2 rounded-lg border border-amber-300 text-xs font-bold bg-white">
                                <option value="none">Nítida desde o início</option>
                                <option value="blur">Desfocada (Blur progressivo)</option>
                                <option value="zoom">Super Zoom (Zoom-out progressivo)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Secção de Opções (para Quiz, Poll e Ranking) -->
                    <div id="options-editor-section">
